{
  "version": 1,
  "description": "Profile manifest for the ccr router. Every installed plugin and standalone skill is either assigned to exactly one domain profile or listed as unassigned (installed, hidden everywhere). Plugins may appear in more than one profile only when the domain genuinely needs them.",
  "models": {
    "router": "haiku",
    "hard": "opus",
    "easy": "haiku"
  },
  "modelEnv": {
    "router": "CCR_ROUTER_MODEL",
    "hard": "CCR_HARD_MODEL",
    "easy": "CCR_EASY_MODEL"
  },
  "router": {
    "agent": "ccr-router",
    "prompt": "prompts/router.md",
    "description": "User-facing router: classify intent, dispatch background Claude Code sessions with the right profile and model, keep each session's must-retain context current, and report progress.",
    "maxActiveChildren": 3,
    "plugins": [
      "nowledge-mem@nowledge-community",
      "remember@claude-plugins-official",
      "cloudflare@claude-plugins-official",
      "linear@claude-plugins-official",
      "telegram@claude-plugins-official",
      "claude-session-driver@superpowers-marketplace"
    ],
    "skills": [
      "searching-with-fff"
    ],
    "mcp": [
      "fff"
    ]
  },
  "profiles": {
    "quick": {
      "description": "Easy tasks: a quick question, a one-file small edit, a lookup, or running a command.",
      "prompt": "prompts/quick.md",
      "tier": "easy",
      "permissionMode": "acceptEdits",
      "effort": "low",
      "plugins": [],
      "skills": [
        "searching-with-fff"
      ],
      "mcp": [
        "fff"
      ],
      "keywords": [
        "quick question",
        "quick fix",
